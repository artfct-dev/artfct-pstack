        "extension": "./src/pstack.ts",
        "manifest": "./package.json"
      },
      "portable": {
        "skills": "./skills/"
      }
    }
  },
  "keywords": [
    "poteto-mode",
    "workflow",
    "code-review",
    "verification"
  ],
  "license": "MIT",
  "name": "artfct-pstack",
  "repository": "https://github.com/artfct-dev/artfct-pstack",
  "version": "0.1.4"
}
