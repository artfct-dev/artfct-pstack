{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "author": {
    "name": "artfct-pstack contributors"
  },
  "description": "Add-on that works alongside pstack: rigorous poteto-mode workflows with proof published to Artfct.",
  "extensions": {
    "dev.artfct.pstack": {
      "cursor": {
        "automations": "./automations/benny/"
      },
      "omp": {
